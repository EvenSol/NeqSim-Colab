    "    & (surf_results[\"SURF concept\"] == selected_surf_name),\n",
    "    \"SURF CAPEX [MUSD]\",\n",
    "].iloc[0]\n",
    "selected_topside_definition = TOPSIDE_CONCEPTS[\n",
