    "}\n",
    "\n",
    "volve_inventory_rows = []\n",
    "for file_group, file_pattern in volve_file_patterns.items():\n",
    "    matching_files = (\n",
    "        list(volve_data_root.rglob(file_pattern))\n",
    "        if volve_data_root.exists()\n",
    "        else []\n",
    "    )\n",
    "    volve_inventory_rows.append(\n",
    "        {\n",
