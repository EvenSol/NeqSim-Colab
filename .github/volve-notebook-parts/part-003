    "black_oil_path = OUTPUT_DIRECTORY / \"NEQSIM_PVT.INC\"\n",
    "black_oil_path.write_text(black_oil_include, encoding=\"utf-8\")\n",
    "\n",
    "pvt_contracts = pd.DataFrame(\n",
