    "            snapshot_label,\n",
    "            snapshot_row[\"oil_rate_Sm3_day\"],\n",
    "            snapshot_row[\"gas_rate_Sm3_day\"],\n",
    "            snapshot_row[\"water_rate_Sm3_day\"],\n",
    "        )\n",
    "    )\n",
    "\n",
    "topside_results = pd.DataFrame(topside_rows)\n",
    "display(topside_results)\n"
