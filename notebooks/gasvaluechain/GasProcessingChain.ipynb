    "import math\n",
    "import re\n",
    "import textwrap\n",
    "from importlib.metadata import version\n",
    "from pathlib import Path\n",
    "\n",
    "import matplotlib.pyplot as plt\n",
    "import pandas as pd\n",
    "from matplotlib.patches import FancyArrowPatch\n",
    "\n",
    "PLOT_COLORS = {\n",
    "    \"blue\": \"#0072B2\",\n",
    "    \"orange\": \"#E69F00\",\n",
    "    \"green\": \"#009E73\",\n",
    "    \"red\": \"#D55E00\",\n",
    "    \"purple\": \"#CC79A7\",\n",
    "}\n",
    "\n",
    "\n",
    "def draw_process_from_dot(dot_text, title):\n",
    "    \"\"\"Render a NeqSim DOT export without requiring the system Graphviz executable.\"\"\"\n",
    "    node_pattern = re.compile(r'^\\s*\"([^\"]+)\";\\s*$')\n",
    "    edge_pattern = re.compile(r'^\\s*\"([^\"]+)\" -> \"([^\"]+)\"')\n",
    "    nodes = []\n",
    "    edges = []\n",
    "\n",
    "    for line in dot_text.splitlines():\n",
    "        node_match = node_pattern.match(line)\n",
    "        edge_match = edge_pattern.match(line)\n",
    "        if node_match:\n",
    "            nodes.append(node_match.group(1))\n",
    "        elif edge_match:\n",
    "            edges.append(edge_match.groups())\n",
    "\n",
    "    node_order = {node: index for index, node in enumerate(nodes)}\n",
    "    layer_by_node = {node: 0 for node in nodes}\n",
    "\n",
    "    for _ in nodes:\n",
    "        for source, target in edges:\n",
    "            if node_order[target] > node_order[source]:\n",
    "                candidate_layer = layer_by_node[source] + 1\n",
    "                layer_by_node[target] = max(layer_by_node[target], candidate_layer)\n",
    "\n",
    "    nodes_by_layer = {}\n",
    "    for node in nodes:\n",
    "        nodes_by_layer.setdefault(layer_by_node[node], []).append(node)\n",
    "\n",
    "    positions = {}\n",
    "    maximum_layer = max(nodes_by_layer, default=0)\n",
    "    maximum_rows = max((len(group) for group in nodes_by_layer.values()), default=1)\n",
    "    for layer, group in nodes_by_layer.items():\n",
    "        x_position = layer / max(maximum_layer, 1)\n",
    "        for row, node in enumerate(group):\n",
    "            y_position = (row + 1) / (len(group) + 1)\n",
    "            positions[node] = (x_position, y_position)\n",
    "\n",
    "    figure_height = max(7.0, 1.35 * maximum_rows)\n",
    "    figure_width = max(18.0, 1.35 * (maximum_layer + 1))\n",
    "    figure, axis = plt.subplots(figsize=(figure_width, figure_height))\n",
    "    for source, target in edges:\n",
    "        is_recycle = node_order[target] <= node_order[source]\n",
    "        connection_style = \"arc3,rad=0.20\" if is_recycle else \"arc3,rad=0.02\"\n",
    "        arrow = FancyArrowPatch(\n",
    "            positions[source],\n",
    "            positions[target],\n",
    "            arrowstyle=\"-|>\",\n",
    "            color=PLOT_COLORS[\"green\"] if is_recycle else \"#666666\",\n",
    "            connectionstyle=connection_style,\n",
    "            linewidth=1.2,\n",
    "            mutation_scale=10,\n",
    "            alpha=0.85,\n",
    "            zorder=1,\n",
    "        )\n",
    "        axis.add_patch(arrow)\n",
    "\n",
    "    for node, (x_position, y_position) in positions.items():\n",
    "        label = textwrap.fill(node, width=12)\n",
    "        axis.text(\n",
    "            x_position,\n",
    "            y_position,\n",
    "            label,\n",
    "            ha=\"center\",\n",
    "            va=\"center\",\n",
    "            fontsize=7.5,\n",
    "            bbox={\n",
    "                \"boxstyle\": \"round,pad=0.25\",\n",
    "                \"facecolor\": \"#D9EAF7\",\n",
    "                \"edgecolor\": PLOT_COLORS[\"blue\"],\n",
    "                \"linewidth\": 1.0,\n",
    "            },\n",
    "            zorder=2,\n",
    "        )\n",
    "\n",
    "    axis.set_title(title, fontsize=14, pad=16)\n",
    "    axis.text(\n",
    "        0.01,\n",
    "        0.01,\n",
    "        \"Green curved arrows indicate recycle connections.\",\n",
    "        transform=axis.transAxes,\n",
    "        fontsize=9,\n",
    "    )\n",
    "    axis.set_xlim(-0.04, 1.04)\n",
    "    axis.set_ylim(-0.05, 1.05)\n",
    "    axis.axis(\"off\")\n",
    "    figure.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "\n",
    "print(f\"NeqSim package version: {version('neqsim')}\")\n"
   ]
  },
