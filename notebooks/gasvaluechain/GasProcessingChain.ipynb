     ]
    }
   ],
   "source": [
    "terminal_delta_t_hot_end = (\n",
    "    heating_medium_inlet_temperature - dewPointControlCooler.getOutStream().getTemperature(\"C\")\n",
    ")\n",
    "terminal_delta_t_cold_end = (\n",
    "    heating_medium_outlet_temperature - richGasMixer.getOutStream().getTemperature(\"C\")\n",
    ")\n",
    "rich_gas_heater_lmtd = log_mean_temperature_difference(\n",
    "    terminal_delta_t_hot_end,\n",
    "    terminal_delta_t_cold_end,\n",
    ")\n",
    "rich_gas_heater_area = (\n",
    "    abs(gasHeaterDuty) * 1.0e3 / overall_heat_transfer_coefficient / rich_gas_heater_lmtd\n",
    ")\n",
    "print(f\"Rich-gas heater LMTD: {rich_gas_heater_lmtd:.3f} K\")\n",
    "print(f\"Rich-gas heater area: {rich_gas_heater_area:.3f} mÂ²\")\n"
   ]
  },
