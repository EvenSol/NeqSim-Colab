   "source": [
    "## Q7 â€” Export-pipeline diameter and profiles\n",
    "\n",
    "Use NeqSim's one-phase pipe-flow system with terrain, roughness, and heat-transfer profiles. The\n",
    "original 0.965 m diameter reached only 96.26 bara at the onshore end. A 0.987 m screening diameter\n",
    "is used here and verified against the 110 bara minimum inlet target.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 27,
   "metadata": {
    "colab": {
     "base_uri": "https://localhost:8080/"
    },
    "id": "Tpz-TauqV6Cv",
    "outputId": "3e78a665-f090-4e16-f57a-494cc7d6dcc9"
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "outlet pressure  111.05299166768783\n",
      "outlet temperature  -0.1786639581057443\n"
     ]
    }
   ],
   "source": [
    "from neqsim.process import pipeline\n",
    "\n",
    "# Creating stream and pipeline\n",
    "clearProcess()\n",
    "\n",
    "diameter = [0.987, 0.987, 0.987, 0.987, 0.987]  # meter\n",
    "roughness = [50.0e-6, 50.0e-6, 50.0e-6, 50.0e-6, 50.0e-6]  # meter\n",
    "position = [0.0, 5000.0, 100000.0, 600000.0, 700000.0]  # meter\n",
    "height = [0.0, -200.0, -300.0, -250.0, 0.0]  # meter\n",
    "outtemperatures = [278.15, 278.15, 278.15, 278.15, 278.15]  # Kelvin\n",
    "outHeatU = [25.0, 25.0, 25.0, 25.0, 25.0]  # W/m2K\n",
    "wallHeatU = [35.0, 35.0, 35.0, 35.0, 35.0]  # W/m2K\n",
    "\n",
    "pipe1 = pipeline(\n",
    "    \"pipeline\",\n",
    "    exportGas,\n",
    "    position,\n",
    "    diameter,\n",
    "    height,\n",
    "    outtemperatures,\n",
    "    roughness,\n",
    "    outHeatU,\n",
    "    wallHeatU,\n",
    ")\n",
    "pipe1.setNumberOfNodesInLeg(100)\n",
    "runProcess()\n",
    "numberofnodes = pipe1.getPipe().getTotalNumberOfNodes()\n",
    "print(\n",
    "    \"outlet pressure \",\n",
    "    pipe1.getPipe().getNode(numberofnodes - 1).getBulkSystem().getPressure(\"bara\"),\n",
    ")\n",
    "print(\n",
    "    \"outlet temperature \",\n",
    "    pipe1.getPipe().getNode(numberofnodes - 1).getBulkSystem().getTemperature(\"C\"),\n",
    ")\n"
   ]
  },
