    "            \"Limiting equipment\",\n",
    "        ]\n",
    "    ].round(4)\n",
    ")\n",
    "print(\n",
    "    \"Maximum screened topside rate:\",\n",
    "    f\"{topside_capacity_msm3_day:.3f} MSm³/day\",\n",
    ")"
   ]
