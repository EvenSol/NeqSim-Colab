    "}\n",
    "\n",
    "RESERVOIR_PRESSURE_BARA = 250.0\n",
    "RESERVOIR_TEMPERATURE_C = 85.0\n",
    "PRODUCTIVITY_INDEX = 80.0\n",
    "TUBING_LENGTH_M = 2_800.0\n",
    "TUBING_DIAMETER_IN = 4.5\n",
