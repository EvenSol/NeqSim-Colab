    "        },\n",
    "        {\n",
    "            \"leg\": \"Arch leg\",\n",
    "            \"length_m\": 650.0,\n",
    "            \"elevation_change_m\": 180.0,\n",
    "        },\n",
    "        {\n",
    "            \"leg\": \"Top riser\",\n",
    "            \"length_m\": 700.0,\n",
    "            \"elevation_change_m\": 500.0,\n",
    "        },\n",
    "    ]\n",
    ")\n",
    "LEG_SPECS[\"angle_deg\"] = np.degrees(\n",
    "    np.arcsin(\n",
    "        LEG_SPECS[\"elevation_change_m\"]\n",
    "        / LEG_SPECS[\"length_m\"]\n",
    "    )\n",
    ")\n",
    "display(LEG_SPECS.round(3))"
   ]
