   "cell_type": "markdown",
   "id": "b1e39053",
   "metadata": {
    "id": "b1e39053"
   },
   "source": [
    "## 3. DQN agent, target network, and safety supervisor\n",
    "\n",
    "The target for a non-terminal transition follows the Bellman update:\n",
    "\n",
    "$$y_t = r_t + \\gamma\\max_a Q_{\\mathrm{target}}(\\mathbf{x}_{t+1}, a).$$\n",
    "\n",
    "The online network minimizes a Huber loss between $y_t$ and\n",
    "$Q(\\mathbf{x}_t,a_t)$. Exploration is epsilon-greedy:\n",
    "\n",
    "$$a_t = \\mathrm{random\\ action}, \\qquad z < \\epsilon.$$\n",
    "\n",
    "and\n",
    "\n",
    "$$a_t = \\arg\\max_a Q(\\mathbf{x}_t,a), \\qquad z \\geq \\epsilon.$$\n",
    "\n",
    "Expert-guided initialization supplies physically sensible examples before DQN replay: close the\n",
    "liquid valve when level is low, and open the gas valve when pressure is high. The learned network\n",
    "still ranks all actions. During deployment, a supervisor prevents an action from worsening a\n",
    "large existing level or pressure error."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "e776e1af",
   "metadata": {
    "colab": {
     "base_uri": "https://localhost:8080/"
    },
    "id": "e776e1af",
    "outputId": "09874e77-afd1-4039-94a8-71b008d7838c"
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "DQN agent and safety supervisor defined.\n"
     ]
    }
   ],
   "source": [
    "def encode_action(feed_delta, gas_delta, liquid_delta):\n",
    "    \"\"\"Return the action index for one simultaneous valve move.\"\"\"\n",
    "    return ACTION_DELTAS.index((feed_delta, gas_delta, liquid_delta))\n",
    "\n",
    "\n",
    "def expert_action(state):\n",
    "    \"\"\"Construct a simple physically directed demonstration action.\"\"\"\n",
    "    level_error = float(state[3])\n",
    "    pressure_error_bara = float(state[4] * 10.0)\n",
    "    feed_delta = 2.0 if level_error < -0.01 else -2.0 if level_error > 0.01 else 0.0\n",
    "    liquid_delta = -2.0 if level_error < -0.01 else 2.0 if level_error > 0.01 else 0.0\n",
    "    gas_delta = 2.0 if pressure_error_bara > 0.10 else -2.0 if pressure_error_bara < -0.10 else 0.0\n",
    "    if pressure_error_bara > 0.30 and feed_delta > 0.0:\n",
    "        feed_delta = 0.0\n",
    "    return encode_action(feed_delta, gas_delta, liquid_delta)\n",
    "\n",
    "\n",
    "class DQNAgent:\n",
    "    \"\"\"Deep Q-Network with replay memory and deterministic save/load support.\"\"\"\n",
    "\n",
    "    def __init__(self, state_size, action_size, learning_rate=0.001):\n",
    "        self.state_size = int(state_size)\n",
    "        self.action_size = int(action_size)\n",
    "        self.memory = deque(maxlen=4000)\n",
    "        self.gamma = 0.97\n",
    "        self.epsilon = 0.35\n",
    "        self.epsilon_min = 0.03\n",
    "        self.epsilon_decay = 0.985\n",
    "        self.batch_size = 64\n",
    "        self.learning_rate = float(learning_rate)\n",
    "        self.epsilon_history = []\n",
    "        self.model = self._build_model()\n",
    "        self.target_model = self._build_model()\n",
    "        self.update_target_model()\n",
    "\n",
    "    def _build_model(self):\n",
    "        model = keras.Sequential(\n",
    "            [\n",
    "                keras.Input(shape=(self.state_size,)),\n",
    "                layers.Dense(64, activation=\"relu\"),\n",
    "                layers.Dense(64, activation=\"relu\"),\n",
    "                layers.Dense(32, activation=\"relu\"),\n",
    "                layers.Dense(self.action_size, activation=\"linear\"),\n",
    "            ]\n",
    "        )\n",
    "        model.compile(\n",
    "            optimizer=keras.optimizers.Adam(learning_rate=self.learning_rate),\n",
    "            loss=keras.losses.Huber(),\n",
    "        )\n",
    "        return model\n",
    "\n",
    "    def update_target_model(self):\n",
    "        \"\"\"Copy online-network weights to the fixed target network.\"\"\"\n",
    "        self.target_model.set_weights(self.model.get_weights())\n",
    "\n",
    "    def remember(self, state, action, reward, next_state, done):\n",
    "        \"\"\"Append one transition to replay memory.\"\"\"\n",
    "        self.memory.append((state, int(action), reward, next_state, bool(done)))\n",
    "\n",
    "    def q_values(self, state):\n",
    "        state_batch = np.asarray(state, dtype=np.float32).reshape(1, -1)\n",
    "        return self.model(state_batch, training=False).numpy()[0]\n",
    "\n",
    "    def act(self, state, training=True):\n",
    "        \"\"\"Choose an epsilon-greedy action without applying supervision.\"\"\"\n",
    "        if training and np.random.random() <= self.epsilon:\n",
    "            return random.randrange(self.action_size)\n",
    "        return int(np.argmax(self.q_values(state)))\n",
    "\n",
    "    def act_safely(self, state):\n",
    "        \"\"\"Rank actions with the DQN, then enforce two directional safety rules.\"\"\"\n",
    "        ranked_actions = np.argsort(self.q_values(state))[::-1]\n",
    "        level_error = float(state[3])\n",
    "        pressure_error_bara = float(state[4] * 10.0)\n",
    "\n",
    "        for action in ranked_actions:\n",
    "            feed_delta, gas_delta, liquid_delta = ACTION_DELTAS[int(action)]\n",
    "            level_safe = (\n",
    "                abs(level_error) <= 0.03\n",
    "                or (\n",
    "                    level_error < 0.0\n",
    "                    and liquid_delta < 0.0\n",
    "                    and feed_delta > 0.0\n",
    "                )\n",
    "                or (\n",
    "                    level_error > 0.0\n",
    "                    and liquid_delta > 0.0\n",
    "                    and feed_delta < 0.0\n",
    "                )\n",
    "            )\n",
    "            pressure_safe = (\n",
    "                abs(pressure_error_bara) <= 0.30\n",
    "                or (pressure_error_bara < 0.0 and gas_delta < 0.0)\n",
    "                or (pressure_error_bara > 0.0 and gas_delta > 0.0)\n",
    "            )\n",
    "            if level_safe and pressure_safe:\n",
    "                return int(action)\n",
    "        return expert_action(state)\n",
    "\n",
    "    def replay(self):\n",
    "        \"\"\"Perform one vectorized replay update with Keras train_on_batch.\"\"\"\n",
    "        if len(self.memory) < self.batch_size:\n",
    "            return 0.0\n",
    "\n",
    "        minibatch = random.sample(self.memory, self.batch_size)\n",
    "        states = np.asarray([item[0] for item in minibatch], dtype=np.float32)\n",
    "        actions = np.asarray([item[1] for item in minibatch], dtype=np.int32)\n",
    "        rewards = np.asarray([item[2] for item in minibatch], dtype=np.float32)\n",
    "        next_states = np.asarray([item[3] for item in minibatch], dtype=np.float32)\n",
    "        dones = np.asarray([item[4] for item in minibatch], dtype=bool)\n",
    "\n",
    "        targets = self.model(states, training=False).numpy()\n",
    "        next_q = self.target_model(next_states, training=False).numpy()\n",
    "        batch_rows = np.arange(self.batch_size)\n",
    "        targets[batch_rows, actions] = rewards + (\n",
    "            1.0 - dones.astype(np.float32)\n",
    "        ) * self.gamma * np.max(next_q, axis=1)\n",
    "\n",
    "        loss = float(self.model.train_on_batch(states, targets))\n",
    "        self.epsilon = max(self.epsilon_min, self.epsilon * self.epsilon_decay)\n",
    "        self.epsilon_history.append(self.epsilon)\n",
    "        return loss\n",
    "\n",
    "    def pretrain_from_expert(self, samples=1500, epochs=20):\n",
    "        \"\"\"Initialize Q ranking from bounded synthetic expert states.\"\"\"\n",
    "        generator = np.random.default_rng(SEED)\n",
    "        states = np.zeros((samples, self.state_size), dtype=np.float32)\n",
    "        states[:, 0] = generator.uniform(0.10, 0.60, samples)\n",
    "        states[:, 1] = generator.uniform(0.35, 0.70, samples)\n",
    "        states[:, 2] = generator.uniform(80.0 / 300.0, 220.0 / 300.0, samples)\n",
    "        states[:, 3] = generator.uniform(-0.25, 0.25, samples)\n",
    "        states[:, 4] = generator.uniform(-0.20, 0.20, samples)\n",
    "        states[:, 5:] = generator.uniform(0.15, 0.85, (samples, 3))\n",
    "\n",
    "        targets = np.full((samples, self.action_size), -1.0, dtype=np.float32)\n",
    "        for index, state in enumerate(states):\n",
    "            targets[index, expert_action(state)] = 1.0\n",
    "        self.model.fit(\n",
    "            states,\n",
    "            targets,\n",
    "            batch_size=128,\n",
    "            epochs=epochs,\n",
    "            verbose=0,\n",
    "            shuffle=False,\n",
    "        )\n",
    "        self.update_target_model()\n",
    "\n",
    "    def save(self, filepath):\n",
    "        self.model.save_weights(filepath)\n",
    "\n",
    "    def load(self, filepath):\n",
    "        self.model.load_weights(filepath)\n",
    "        self.update_target_model()\n",
    "\n",
    "\n",
    "print(\"DQN agent and safety supervisor defined.\")"
   ]
  },
