    "ACTION_DELTAS = list(product((-2.0, 0.0, 2.0), repeat=3))\n",
    "\n",
    "\n",
    "def create_well_fluid():\n",
    "    \"\"\"Return the preserved synthetic oil-and-gas feed fluid.\"\"\"\n",
    "    well_fluid = fluid(\"pr\")\n",
    "    well_fluid.addComponent(\"CO2\", 1.5870)\n",
    "    well_fluid.addComponent(\"methane\", 52.51)\n",
    "    well_fluid.addComponent(\"ethane\", 6.24)\n",
    "    well_fluid.addComponent(\"propane\", 4.23)\n",
    "    well_fluid.addComponent(\"i-butane\", 0.855)\n",
    "    well_fluid.addComponent(\"n-butane\", 2.213)\n",
    "    well_fluid.addComponent(\"i-pentane\", 1.124)\n",
    "    well_fluid.addComponent(\"n-pentane\", 1.271)\n",
    "    well_fluid.addComponent(\"n-hexane\", 2.289)\n",
    "\n",
    "    tbp_fractions = [\n",
    "        (\"C7+_cut1\", 0.8501, 108.47, 0.7411),\n",
    "        (\"C7+_cut2\", 1.2802, 120.40, 0.7550),\n",
    "        (\"C7+_cut3\", 1.6603, 133.64, 0.7695),\n",
    "        (\"C7+_cut4\", 6.5311, 164.70, 0.7990),\n",
    "        (\"C7+_cut5\", 6.3311, 215.94, 0.8387),\n",
    "        (\"C7+_cut6\", 4.9618, 273.34, 0.8754),\n",
    "        (\"C7+_cut7\", 2.9105, 334.92, 0.90731),\n",
    "        (\"C7+_cut8\", 3.0505, 412.79, 0.9575),\n",
    "    ]\n",
    "    for name, amount, molar_mass_g_per_mol, density in tbp_fractions:\n",
    "        well_fluid.addTBPfraction(\n",
    "            name,\n",
    "            amount,\n",
    "            molar_mass_g_per_mol / 1000.0,\n",
    "            density,\n",
    "        )\n",
    "\n",
    "    well_fluid.setPressure(10.0, \"bara\")\n",
    "    well_fluid.setTemperature(300.0, \"K\")\n",
    "    well_fluid.setMixingRule(\"classic\")\n",
    "    return well_fluid\n",
    "\n",
    "\n",
    "class SeparatorEnvironment:\n",
    "    \"\"\"High-fidelity NeqSim environment for three-valve separator control.\"\"\"\n",
    "\n",
    "    def __init__(\n",
    "        self,\n",
    "        time_step_s=50.0,\n",
    "        level_setpoint=0.30,\n",
    "        pressure_setpoint_bara=5.0,\n",
    "        flow_rate_kg_per_h=150.0,\n",
    "        max_steps=120,\n",
    "    ):\n",
    "        self.time_step_s = float(time_step_s)\n",
    "        self.level_setpoint = float(level_setpoint)\n",
    "        self.pressure_setpoint_bara = float(pressure_setpoint_bara)\n",
    "        self.flow_rate_setpoint_kg_per_h = float(flow_rate_kg_per_h)\n",
    "        self.max_steps = int(max_steps)\n",
    "        self.action_space_n = len(ACTION_DELTAS)\n",
    "        self.state_space_n = 8\n",
    "        self.min_valve_opening = 1.0\n",
    "        self.max_valve_opening = 99.0\n",
    "        self.process = None\n",
    "        self.current_step = 0\n",
    "\n",
    "    def set_level_setpoint(self, setpoint):\n",
    "        \"\"\"Change the level target, bounded to a physically meaningful fraction.\"\"\"\n",
    "        self.level_setpoint = float(np.clip(setpoint, 0.10, 0.90))\n",
    "\n",
    "    def set_pressure_setpoint(self, setpoint_bara):\n",
    "        \"\"\"Change the separator pressure target in bara.\"\"\"\n",
    "        self.pressure_setpoint_bara = float(np.clip(setpoint_bara, 3.0, 8.0))\n",
    "\n",
    "    def set_flow_rate(self, flow_rate_kg_per_h):\n",
    "        \"\"\"Change feed flow while retaining a bounded training envelope.\"\"\"\n",
    "        bounded_flow = float(np.clip(flow_rate_kg_per_h, 80.0, 220.0))\n",
    "        self.flow_rate_setpoint_kg_per_h = bounded_flow\n",
    "        if self.process is not None:\n",
    "            self.well_stream.setFlowRate(bounded_flow, \"kg/hr\")\n",
    "\n",
    "    def create_process(self):\n",
    "        \"\"\"Build the transient NeqSim separator and measurement system.\"\"\"\n",
    "        well_fluid = create_well_fluid()\n",
    "        well_stream = jneqsim.process.equipment.stream.Stream(\n",
    "            \"well stream\",\n",
    "            well_fluid,\n",
    "        )\n",
    "        well_stream.setFlowRate(self.flow_rate_setpoint_kg_per_h, \"kg/hr\")\n",
    "\n",
    "        feed_valve = jneqsim.process.equipment.valve.ThrottlingValve(\n",
    "            \"LCV-00\",\n",
    "            well_stream,\n",
    "        )\n",
    "        feed_valve.setPercentValveOpening(50.0)\n",
    "        feed_valve.setOutletPressure(5.0, \"bara\")\n",
    "        feed_valve.setCalculateSteadyState(False)\n",
    "        feed_valve.setMinimumValveOpening(0.01)\n",
    "\n",
    "        separator = jneqsim.process.equipment.separator.Separator(\n",
    "            \"V-001\",\n",
    "            feed_valve.getOutletStream(),\n",
    "        )\n",
    "        separator.setCalculateSteadyState(False)\n",
    "        separator.setSeparatorLength(4.0)\n",
    "        separator.setInternalDiameter(1.0)\n",
    "        separator.setLiquidLevel(0.20)\n",
    "\n",
    "        liquid_valve = jneqsim.process.equipment.valve.ThrottlingValve(\n",
    "            \"LCV-001\",\n",
    "            separator.getLiquidOutStream(),\n",
    "        )\n",
    "        liquid_valve.setPercentValveOpening(50.0)\n",
    "        liquid_valve.setOutletPressure(2.0, \"bara\")\n",
    "        liquid_valve.setCalculateSteadyState(False)\n",
    "\n",
    "        gas_valve = jneqsim.process.equipment.valve.ThrottlingValve(\n",
    "            \"PCV-001\",\n",
    "            separator.getGasOutStream(),\n",
    "        )\n",
    "        gas_valve.setPercentValveOpening(50.0)\n",
    "        gas_valve.setOutletPressure(2.0, \"bara\")\n",
    "        gas_valve.setCalculateSteadyState(False)\n",
    "\n",
    "        level_transmitter = jneqsim.process.measurementdevice.LevelTransmitter(separator)\n",
    "        level_transmitter.setMinimumValue(0.01)\n",
    "        level_transmitter.setMaximumValue(0.99)\n",
    "\n",
    "        pressure_transmitter = (\n",
    "            jneqsim.process.measurementdevice.PressureTransmitter(\n",
    "                separator.getGasOutStream(),\n",
    "            )\n",
    "        )\n",
    "        pressure_transmitter.setMinimumValue(0.01)\n",
    "        pressure_transmitter.setMaximumValue(10.0)\n",
    "\n",
    "        process = jneqsim.process.processmodel.ProcessSystem(\"oil process\")\n",
    "        for unit in (\n",
    "            well_stream,\n",
    "            feed_valve,\n",
    "            separator,\n",
    "            liquid_valve,\n",
    "            gas_valve,\n",
    "            level_transmitter,\n",
    "            pressure_transmitter,\n",
    "        ):\n",
    "            process.add(unit)\n",
    "\n",
    "        process.run()\n",
    "        process.setTimeStep(self.time_step_s)\n",
    "        process.runTransient()\n",
    "\n",
    "        self.well_stream = well_stream\n",
    "        self.feed_valve = feed_valve\n",
    "        self.separator = separator\n",
    "        self.liquid_valve = liquid_valve\n",
    "        self.gas_valve = gas_valve\n",
    "        self.level_tx = level_transmitter\n",
    "        self.pressure_tx = pressure_transmitter\n",
    "        return process\n",
    "\n",
    "    def reset(self):\n",
    "        \"\"\"Create a fresh process state for an independent episode.\"\"\"\n",
    "        self.process = self.create_process()\n",
    "        self.current_step = 0\n",
    "        return self._get_state()\n",
    "\n",
    "    def _get_state(self):\n",
    "        \"\"\"Return the normalized eight-variable controller state.\"\"\"\n",
    "        level = float(self.level_tx.getMeasuredValue())\n",
    "        pressure_bara = float(self.pressure_tx.getMeasuredValue())\n",
    "        flow_rate = float(self.well_stream.getFlowRate(\"kg/hr\"))\n",
    "        return np.array(\n",
    "            [\n",
    "                level,\n",
    "                pressure_bara / 10.0,\n",
    "                flow_rate / 300.0,\n",
    "                level - self.level_setpoint,\n",
    "                (pressure_bara - self.pressure_setpoint_bara) / 10.0,\n",
    "                self.feed_valve.getPercentValveOpening() / 100.0,\n",
    "                self.gas_valve.getPercentValveOpening() / 100.0,\n",
    "                self.liquid_valve.getPercentValveOpening() / 100.0,\n",
    "            ],\n",
    "            dtype=np.float32,\n",
    "        )\n",
    "\n",
    "    def _set_opening(\n",
    "        self,\n",
    "        valve,\n",
    "        delta,\n",
    "        minimum_opening=None,\n",
    "        maximum_opening=None,\n",
    "    ):\n",
    "        current_opening = float(valve.getPercentValveOpening())\n",
    "        lower_bound = (\n",
    "            self.min_valve_opening\n",
    "            if minimum_opening is None\n",
    "            else minimum_opening\n",
    "        )\n",
    "        upper_bound = (\n",
    "            self.max_valve_opening\n",
    "            if maximum_opening is None\n",
    "            else maximum_opening\n",
    "        )\n",
    "        new_opening = np.clip(\n",
    "            current_opening + delta,\n",
    "            lower_bound,\n",
    "            upper_bound,\n",
    "        )\n",
    "        valve.setPercentValveOpening(float(new_opening))\n",
    "\n",
    "    def step(self, action):\n",
    "        \"\"\"Apply one simultaneous three-valve action and advance NeqSim.\"\"\"\n",
    "        feed_delta, gas_delta, liquid_delta = ACTION_DELTAS[int(action)]\n",
    "        self._set_opening(\n",
    "            self.feed_valve,\n",
    "            feed_delta,\n",
    "            minimum_opening=30.0,\n",
    "            maximum_opening=70.0,\n",
    "        )\n",
    "        self._set_opening(self.gas_valve, gas_delta)\n",
    "        self._set_opening(self.liquid_valve, liquid_delta)\n",
    "        self.process.runTransient()\n",
    "\n",
    "        next_state = self._get_state()\n",
    "        level_error = float(next_state[3])\n",
    "        pressure_error_bara = float(next_state[4] * 10.0)\n",
    "        movement = abs(feed_delta) + abs(gas_delta) + abs(liquid_delta)\n",
    "        reward = (\n",
    "            -4.0 * (level_error / 0.10) ** 2\n",
    "            -2.0 * (pressure_error_bara / 0.50) ** 2\n",
    "            -0.02 * movement\n",
    "        )\n",
    "\n",
    "        level = float(next_state[0])\n",
    "        pressure_bara = float(next_state[1] * 10.0)\n",
    "        self.current_step += 1\n",
    "        unsafe = level < 0.05 or level > 0.95 or pressure_bara < 2.5 or pressure_bara > 9.0\n",
    "        done = self.current_step >= self.max_steps or unsafe\n",
    "        return next_state, float(reward), bool(done)\n",
    "\n",
    "\n",
    "print(f\"Environment state dimension: {SeparatorEnvironment().state_space_n}\")\n",
    "print(f\"Simultaneous action count: {len(ACTION_DELTAS)}\")"
   ]
  },
