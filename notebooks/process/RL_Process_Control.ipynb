   "source": [
    "## 4. Efficient high-fidelity training\n",
    "\n",
    "The old notebook invoked Keras `fit()` after every NeqSim step; its saved run required more than\n",
    "an hour and still produced a policy that never reached the level band. Here, NeqSim remains the\n",
    "transition model, but replay is vectorized and performed every four steps. Each episode starts\n",
    "from a new thermodynamic process state, and disturbances are varied deterministically."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "1da43988",
   "metadata": {
    "colab": {
     "base_uri": "https://localhost:8080/"
    },
    "id": "1da43988",
    "outputId": "39d63be9-b97e-462e-ec24-8934a8a29120"
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Vectorized NeqSim training function defined.\n"
     ]
    }
   ],
   "source": [
    "def train_agent(episodes=12, update_target_frequency=3):\n",
    "    \"\"\"Train a supervised-initialized DQN against NeqSim transitions.\"\"\"\n",
    "    agent = DQNAgent(\n",
    "        state_size=8,\n",
    "        action_size=len(ACTION_DELTAS),\n",
    "        learning_rate=0.0007,\n",
    "    )\n",
    "    agent.pretrain_from_expert()\n",
    "\n",
    "    episode_rewards = []\n",
    "    episode_lengths = []\n",
    "    losses = []\n",
    "    start_time = time.perf_counter()\n",
    "\n",
    "    for episode in range(episodes):\n",
    "        level_target = 0.28 + 0.04 * ((episode % 3) / 2.0)\n",
    "        pressure_target = 4.8 + 0.4 * ((episode % 4) / 3.0)\n",
    "        flow_target = 130.0 + 40.0 * ((episode % 5) / 4.0)\n",
    "        environment = SeparatorEnvironment(\n",
    "            level_setpoint=level_target,\n",
    "            pressure_setpoint_bara=pressure_target,\n",
    "            flow_rate_kg_per_h=flow_target,\n",
    "            max_steps=80,\n",
    "        )\n",
    "        state = environment.reset()\n",
    "        total_reward = 0.0\n",
    "        episode_losses = []\n",
    "\n",
    "        for step in range(environment.max_steps):\n",
    "            action = agent.act(state, training=True)\n",
    "            next_state, reward, done = environment.step(action)\n",
    "            agent.remember(state, action, reward, next_state, done)\n",
    "            total_reward += reward\n",
    "            state = next_state\n",
    "\n",
    "            if step % 4 == 0:\n",
    "                loss = agent.replay()\n",
    "                if loss > 0.0:\n",
    "                    episode_losses.append(loss)\n",
    "            if done:\n",
    "                break\n",
    "\n",
    "        if (episode + 1) % update_target_frequency == 0:\n",
    "            agent.update_target_model()\n",
    "\n",
    "        episode_rewards.append(total_reward)\n",
    "        episode_lengths.append(step + 1)\n",
    "        losses.append(float(np.mean(episode_losses)) if episode_losses else 0.0)\n",
    "        print(\n",
    "            f\"Episode {episode + 1:02d}/{episodes}: \"\n",
    "            f\"reward={total_reward:9.2f}, \"\n",
    "            f\"steps={step + 1:3d}, \"\n",
    "            f\"epsilon={agent.epsilon:.3f}, \"\n",
    "            f\"loss={losses[-1]:.4f}\"\n",
    "        )\n",
    "\n",
    "    elapsed_seconds = time.perf_counter() - start_time\n",
    "    print(f\"Training time: {elapsed_seconds:.1f} s\")\n",
    "    return agent, episode_rewards, episode_lengths, losses, elapsed_seconds\n",
    "\n",
    "\n",
    "print(\"Vectorized NeqSim training function defined.\")"
   ]
  },
