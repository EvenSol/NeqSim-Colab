    "## 7. Nominal high-fidelity deployment\n",
    "\n",
    "The trained network is deployed on a fresh NeqSim process, with exploration disabled. The\n",
    "trajectory records the process measurements, setpoints, three valve positions, and safety-\n",
    "supervisor interventions."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "433128cc",
   "metadata": {
    "colab": {
     "base_uri": "https://localhost:8080/"
    },
    "id": "433128cc",
    "outputId": "795f67ed-4af1-40b3-86cb-ff040e4f560d"
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Nominal transitions: 140\n",
      "Level MAE: 0.04797 fraction\n",
      "Pressure MAE: 0.2089 bar\n",
      "Supervisor interventions: 29\n"
     ]
    }
   ],
   "source": [
    "def run_agent_scenario(\n",
    "    agent,\n",
    "    *,\n",
    "    max_steps=140,\n",
    "    level_setpoint=0.30,\n",
    "    pressure_setpoint_bara=5.0,\n",
    "    flow_rate_kg_per_h=150.0,\n",
    "    schedule=None,\n",
    "):\n",
    "    \"\"\"Run a reproducible policy deployment against a fresh NeqSim process.\"\"\"\n",
    "    environment = SeparatorEnvironment(\n",
    "        level_setpoint=level_setpoint,\n",
    "        pressure_setpoint_bara=pressure_setpoint_bara,\n",
    "        flow_rate_kg_per_h=flow_rate_kg_per_h,\n",
    "        max_steps=max_steps,\n",
    "    )\n",
    "    state = environment.reset()\n",
    "    records = []\n",
    "    schedule = schedule or {}\n",
    "\n",
    "    for step in range(max_steps):\n",
    "        if step in schedule:\n",
    "            change = schedule[step]\n",
    "            if \"level_setpoint\" in change:\n",
    "                environment.set_level_setpoint(change[\"level_setpoint\"])\n",
    "            if \"pressure_setpoint_bara\" in change:\n",
    "                environment.set_pressure_setpoint(change[\"pressure_setpoint_bara\"])\n",
    "            if \"flow_rate_kg_per_h\" in change:\n",
    "                environment.set_flow_rate(change[\"flow_rate_kg_per_h\"])\n",
    "\n",
    "        raw_action = agent.act(state, training=False)\n",
    "        safe_action = agent.act_safely(state)\n",
    "        records.append(\n",
    "            {\n",
    "                \"step\": step,\n",
    "                \"time_s\": float(environment.process.getTime()),\n",
    "                \"level_fraction\": float(environment.level_tx.getMeasuredValue()),\n",
    "                \"pressure_bara\": float(environment.pressure_tx.getMeasuredValue()),\n",
    "                \"flow_rate_kg_per_h\": float(environment.well_stream.getFlowRate(\"kg/hr\")),\n",
    "                \"level_setpoint\": environment.level_setpoint,\n",
    "                \"pressure_setpoint_bara\": environment.pressure_setpoint_bara,\n",
    "                \"feed_valve_percent\": float(\n",
    "                    environment.feed_valve.getPercentValveOpening()\n",
    "                ),\n",
    "                \"gas_valve_percent\": float(\n",
    "                    environment.gas_valve.getPercentValveOpening()\n",
    "                ),\n",
    "                \"liquid_valve_percent\": float(\n",
    "                    environment.liquid_valve.getPercentValveOpening()\n",
    "                ),\n",
    "                \"raw_action\": raw_action,\n",
    "                \"applied_action\": safe_action,\n",
    "                \"supervisor_intervened\": raw_action != safe_action,\n",
    "            }\n",
    "        )\n",
    "        state, reward, done = environment.step(safe_action)\n",
    "        records[-1][\"reward\"] = reward\n",
    "        if done:\n",
    "            break\n",
    "\n",
    "    return pd.DataFrame.from_records(records)\n",
    "\n",
    "\n",
    "nominal_results = run_agent_scenario(trained_agent, max_steps=140)\n",
    "nominal_level_mae = float(\n",
    "    np.mean(\n",
    "        np.abs(\n",
    "            nominal_results[\"level_fraction\"]\n",
    "            - nominal_results[\"level_setpoint\"]\n",
    "        )\n",
    "    )\n",
    ")\n",
    "nominal_pressure_mae = float(\n",
    "    np.mean(\n",
    "        np.abs(\n",
    "            nominal_results[\"pressure_bara\"]\n",
    "            - nominal_results[\"pressure_setpoint_bara\"]\n",
    "        )\n",
    "    )\n",
    ")\n",
    "\n",
    "print(f\"Nominal transitions: {len(nominal_results)}\")\n",
    "print(f\"Level MAE: {nominal_level_mae:.5f} fraction\")\n",
    "print(f\"Pressure MAE: {nominal_pressure_mae:.4f} bar\")\n",
    "print(\n",
    "    \"Supervisor interventions: \"\n",
    "    f\"{int(nominal_results['supervisor_intervened'].sum())}\"\n",
    ")"
   ]
  },
